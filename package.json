    "test:luna": "tsx scripts/verify-live.ts --provider=openai --model=gpt-6-luna"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
