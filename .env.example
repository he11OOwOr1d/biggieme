# Set at least ONE model provider key. Keys stay on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
# Set an exact model ID supported by your Anthropic account.
ANTHROPIC_MODEL=
# OpenRouter, Together, local Ollama/LM Studio, or another compatible server.
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
# For a local endpoint that needs no key, explicitly set this to true.
COMPATIBLE_NO_AUTH=false
# One search implementation shared by every model provider.
TAVILY_API_KEY=
DEFAULT_PROVIDER=openai
PORT=4317
HOST=127.0.0.1
DATA_DIR=./data
DEFAULT_TIMEZONE=Asia/Kolkata
# Optional access gate for a self-hosted demo. Set before binding publicly.
APP_ACCESS_TOKEN=
# Background profile extraction; raw messages are searchable regardless.
MEMORY_EXTRACTION=true

# Overall chat deadline, including provider retries (maximum 300000 ms).
CHAT_TIMEOUT_MS=120000
# Vercel-only durable private storage (local development keeps SQLite on disk).
STORAGE_MODE=local
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
